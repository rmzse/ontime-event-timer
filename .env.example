# Kopiera den här filen till .env och fyll i riktiga värden:
#   cp .env.example .env
#
# .env-filen ska ALDRIG committas till Git (är gitignored).

# ====== Cloudflare Tunnel ======
# Hämta token från Cloudflare Dashboard:
# Zero Trust → Networks → Tunnels → Create a tunnel → Docker
# Den ser ut som: eyJhIjoi...lång-base64-sträng...
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# ====== Tidszon ======
# Använd t.ex. Europe/Stockholm, Europe/Berlin, UTC
TZ=Europe/Stockholm
